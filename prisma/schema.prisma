// =========================================================
// Checkmate - Prisma Schema
// Source of Truth for database and ORM
// =========================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =========================================================
// ENUMS
// =========================================================
enum Gender {
  male
  female
  other
  unknown
}

enum AuthProvider {
  google
  naver
  kakao
}

enum BookingStatus {
  booked
  not_booked
}

enum TripStatus {
  planning
  preparing
  completed
}

enum FlightDirection {
  departure
  return
}

enum ChecklistStatus {
  not_started
  preparing
  completed
}

enum ChecklistGeneratedBy {
  llm
  template
  hybrid
}

enum PrepType {
  item
  pre_booking
  pre_departure_check
  ai_recommend
  etc
}

enum BaggageType {
  carry_on
  checked
  none
}

enum ChecklistItemSource {
  llm
  template
  user_added
}

// 개인 짐 / 공동 짐 구분
//   - personal: 멤버마다 각자 체크 (checklist_item_personal_checks 행 기준)
//   - shared  : 한 명만 준비하면 되는 공동 품목 — 공유 체크(isChecked) + 담당자(assigneeUserId)
enum ItemScope {
  personal
  shared
}

enum EditType {
  text
  add
  del
  reorder
}

enum CheckAction {
  checked
  unchecked
}

enum LlmStatus {
  pending
  success
  failed
}

enum UserEventType {
  search
  detail_check
  save
  saved_list_open
  edit_text
  edit_add
  edit_del
  edit_reorder
  prepare_action
  re_search
  missing_item_detection
  page_view
  cta_click
  step_complete
  login
  trip_created
  item_checked
  session_start
}

// =========================================================
// USER DOMAIN
// =========================================================
model User {
  id              BigInt    @id @default(autoincrement())
  email           String    @unique
  nickname        String
  profileImageUrl String?   @map("profile_image_url")
  gender          Gender    @default(unknown)
  birthDate       DateTime? @map("birth_date") @db.Date
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  // --- 약관 / 온보딩 타임스탬프 ---
  // POST /api/users/me/consent 에서 기록. null 이면 아직 동의하지 않은 사용자.
  legalConsentAcceptedAt DateTime? @map("legal_consent_accepted_at")
  // 마케팅 정보 수신 동의 여부. NOT NULL (기본 false).
  marketingOptIn         Boolean   @default(false) @map("marketing_opt_in")
  // 최초로 gender + birthDate 가 모두 입력된 시점 = /onboarding 완료 게이트.
  onboardingCompletedAt  DateTime? @map("onboarding_completed_at")

  authProviders UserAuthProvider[]
  passports     UserPassport[]
  trips         Trip[]
  events        UserEvent[]
  itemEdits     ChecklistItemEdit[]
  itemChecks    ChecklistItemCheck[]
  personalChecks ChecklistItemPersonalCheck[] @relation("PersonalCheckUser")
  assignedItems  ChecklistItem[]              @relation("ChecklistItemAssignee")

  friendshipsRequested Friendship[]   @relation("FriendshipRequester")
  friendshipsReceived  Friendship[]   @relation("FriendshipAddressee")
  friendInvites        FriendInvite[]
  tripMemberships      TripMember[]   @relation("TripMemberUser")
  notifications        Notification[] @relation("NotificationUser")
  notificationActions  Notification[] @relation("NotificationActor")

  @@index([deletedAt])
  @@map("users")
}

// =========================================================
// FRIEND DOMAIN (docs/collab-checklist-plan.md Phase 1)
// =========================================================

enum FriendshipStatus {
  pending // 이메일 요청 방식 확장 대비 (초대 링크 수락은 바로 accepted)
  accepted
  declined
  blocked
}

model Friendship {
  id          BigInt           @id @default(autoincrement())
  requesterId BigInt           @map("requester_id")
  addresseeId BigInt           @map("addressee_id")
  status      FriendshipStatus @default(pending)
  createdAt   DateTime         @default(now()) @map("created_at")
  respondedAt DateTime?        @map("responded_at")

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@map("friendships")
}

// 친구 초대 링크 토큰 — /friends/invite/:token 으로 공유
model FriendInvite {
  id        BigInt   @id @default(autoincrement())
  token     String   @unique
  creatorId BigInt   @map("creator_id")
  expiresAt DateTime @map("expires_at")
  maxUses   Int      @default(10) @map("max_uses")
  usedCount Int      @default(0) @map("used_count")
  createdAt DateTime @default(now()) @map("created_at")

  creator User @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId])
  @@map("friend_invites")
}

model UserAuthProvider {
  id              BigInt       @id @default(autoincrement())
  userId          BigInt       @map("user_id")
  provider        AuthProvider
  providerUserId  String       @map("provider_user_id")
  accessTokenHash String       @map("access_token_hash")
  linkedAt        DateTime     @default(now()) @map("linked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("user_auth_providers")
}

model UserPassport {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  countryId BigInt    @map("country_id")
  isPrimary Boolean   @default(false) @map("is_primary")
  expiresAt DateTime? @map("expires_at") @db.Date

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  country Country @relation(fields: [countryId], references: [id])

  @@index([userId])
  @@map("user_passports")
}

// =========================================================
// MASTER DATA
// =========================================================
model Country {
  id     BigInt @id @default(autoincrement())
  code   String @unique // ISO-3166 alpha-2
  nameKo String @map("name_ko")
  nameEn String @map("name_en")

  cities        City[]
  passports     UserPassport[]
  trips         Trip[]
  itemTemplates ChecklistItemTemplate[]

  @@map("countries")
}

model City {
  id        BigInt  @id @default(autoincrement())
  countryId BigInt  @map("country_id")
  nameKo    String  @map("name_ko")
  nameEn    String  @map("name_en")
  iataCode  String? @map("iata_code")
  isServed  Boolean @default(false) @map("is_served")

  country    Country    @relation(fields: [countryId], references: [id])
  tripCities TripCity[]

  @@index([countryId])
  @@index([iataCode])
  @@map("cities")
}

model ChecklistCategory {
  id        BigInt @id @default(autoincrement())
  code      String @unique
  labelKo   String @map("label_ko")
  sortOrder Int    @map("sort_order")

  items     ChecklistItem[]
  templates ChecklistItemTemplate[]

  @@map("checklist_categories")
}

model TravelStyle {
  id       BigInt @id @default(autoincrement())
  code     String @unique
  labelKo  String @map("label_ko")
  iconPath String @map("icon_path")

  tripTravelStyles TripTravelStyle[]

  @@map("travel_styles")
}

model CompanionType {
  id      BigInt @id @default(autoincrement())
  code    String @unique
  labelKo String @map("label_ko")

  tripCompanions TripCompanion[]

  @@map("companion_types")
}

// =========================================================
// TRIP DOMAIN
// =========================================================
model Trip {
  id            BigInt        @id @default(autoincrement())
  userId        BigInt        @map("user_id")
  countryId     BigInt        @map("country_id")
  title         String
  tripStart     DateTime      @map("trip_start") @db.Date
  tripEnd       DateTime      @map("trip_end") @db.Date
  bookingStatus BookingStatus @map("booking_status")
  status        TripStatus    @default(planning)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  deletedAt     DateTime?     @map("deleted_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  country Country @relation(fields: [countryId], references: [id])

  cities         TripCity[]
  flights        TripFlight[]
  companions     TripCompanion[]
  travelStyles   TripTravelStyle[]
  checklist      Checklist?
  llmGenerations LlmGeneration[]
  events         UserEvent[]
  members        TripMember[]
  invites        TripInvite[]

  @@index([userId, status])
  @@index([deletedAt])
  @@map("trips")
}

// =========================================================
// TRIP MEMBER DOMAIN — 체크리스트 공동 편집 (docs/collab-checklist-plan.md Phase 2)
// 소유자는 Trip.userId 로 표현하며 TripMember 행을 따로 만들지 않는다.
// =========================================================

enum TripMemberRole {
  owner // 예약 — 현재는 Trip.userId가 소유자, viewer 등 확장 대비
  editor
}

enum TripMemberStatus {
  pending // 친구 바로 추가 = 초대장 — 상대 수락 전
  accepted // 멤버 (초대 링크 합류는 즉시 accepted)
  declined
}

model TripMember {
  id          BigInt           @id @default(autoincrement())
  tripId      BigInt           @map("trip_id")
  userId      BigInt           @map("user_id")
  role        TripMemberRole   @default(editor)
  status      TripMemberStatus @default(accepted)
  invitedBy   BigInt?          @map("invited_by")
  joinedAt    DateTime         @default(now()) @map("joined_at")
  respondedAt DateTime?        @map("responded_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation("TripMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
  @@index([userId])
  @@index([userId, status])
  @@map("trip_members")
}

// =========================================================
// NOTIFICATION DOMAIN (docs/collab-checklist-plan.md Phase 4)
// =========================================================

enum NotificationType {
  trip_invite          // 트립 초대 받음 (수신자 = 초대 대상)
  trip_invite_accepted // 내가 보낸 트립 초대가 수락됨 (수신자 = 초대한 사람)
  trip_member_joined   // 초대 링크로 멤버 합류 (수신자 = 트립 소유자)
  friend_accepted      // 내 친구 초대 링크가 수락됨 (수신자 = 링크 생성자)
  item_assigned        // 공동 짐 담당자로 지정됨 (수신자 = 담당자)
}

model Notification {
  id        BigInt           @id @default(autoincrement())
  userId    BigInt           @map("user_id") // 수신자
  type      NotificationType
  actorId   BigInt?          @map("actor_id") // 행동 주체 (탈퇴 시 null)
  tripId    BigInt?          @map("trip_id")
  payload   Json? // { tripTitle, archiveId 등 표시용 스냅샷 }
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user  User  @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

// 트립 합류 초대 링크 토큰 — /trips/invite/:token 으로 공유
model TripInvite {
  id        BigInt   @id @default(autoincrement())
  tripId    BigInt   @map("trip_id")
  token     String   @unique
  createdBy BigInt   @map("created_by")
  expiresAt DateTime @map("expires_at")
  maxUses   Int      @default(10) @map("max_uses")
  usedCount Int      @default(0) @map("used_count")
  createdAt DateTime @default(now()) @map("created_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@map("trip_invites")
}

model TripCity {
  id             BigInt    @id @default(autoincrement())
  tripId         BigInt    @map("trip_id")
  cityId         BigInt?   @map("city_id")
  customCityName String?   @map("custom_city_name")
  orderIndex     Int       @map("order_index")
  visitStart     DateTime? @map("visit_start") @db.Date
  visitEnd       DateTime? @map("visit_end") @db.Date
  isAutoSynced   Boolean   @default(false) @map("is_auto_synced")

  trip Trip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  city City? @relation(fields: [cityId], references: [id])

  @@index([tripId, orderIndex])
  @@map("trip_cities")
}

model TripFlight {
  id            BigInt          @id @default(autoincrement())
  tripId        BigInt          @map("trip_id")
  direction     FlightDirection
  flightNo      String          @map("flight_no")
  airline       String
  departureIata String          @map("departure_iata")
  arrivalIata   String          @map("arrival_iata")
  departAt      DateTime        @map("depart_at")
  arriveAt      DateTime        @map("arrive_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, direction])
  @@map("trip_flights")
}

model TripCompanion {
  id              BigInt  @id @default(autoincrement())
  tripId          BigInt  @map("trip_id")
  companionTypeId BigInt  @map("companion_type_id")
  hasPet          Boolean @default(false) @map("has_pet")

  trip          Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  companionType CompanionType @relation(fields: [companionTypeId], references: [id])

  @@unique([tripId, companionTypeId])
  @@map("trip_companions")
}

model TripTravelStyle {
  id            BigInt @id @default(autoincrement())
  tripId        BigInt @map("trip_id")
  travelStyleId BigInt @map("travel_style_id")

  trip        Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  travelStyle TravelStyle @relation(fields: [travelStyleId], references: [id])

  @@unique([tripId, travelStyleId])
  @@map("trip_travel_styles")
}

// =========================================================
// CHECKLIST DOMAIN
// =========================================================
model Checklist {
  id             BigInt               @id @default(autoincrement())
  tripId         BigInt               @unique @map("trip_id")
  status         ChecklistStatus      @default(not_started)
  completionRate Decimal              @default(0) @map("completion_rate") @db.Decimal(5, 2)
  generatedBy    ChecklistGeneratedBy @map("generated_by")
  generatedAt    DateTime             @default(now()) @map("generated_at")

  trip     Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  items    ChecklistItem[]
  archives GuideArchive[]

  @@map("checklists")
}

model ChecklistItem {
  id          BigInt              @id @default(autoincrement())
  checklistId BigInt              @map("checklist_id")
  categoryId  BigInt              @map("category_id")
  templateId  BigInt?             @map("template_id")
  title       String
  description String?
  detail      String?
  memo        String?   @map("memo")
  prepType    PrepType            @map("prep_type")
  baggageType BaggageType         @map("baggage_type")
  source      ChecklistItemSource
  orderIndex  Int                 @map("order_index")
  // 후보 풀(candidate pool) 모델
  //   - false: /trips/:id/search 의 추천 풀에는 보이지만 사용자의 "내 체크리스트" 에는 없는 상태.
  //   - true : 사용자가 "담기" 로 채택한 항목. 가이드 보관함 / 내 체크리스트에 표시된다.
  // 이 플래그 도입 전(레거시) 데이터는 전부 담긴 것으로 간주 → migration 에서 true 로 마이그레이션.
  isSelected Boolean   @default(false) @map("is_selected")
  selectedAt DateTime? @map("selected_at")
  isChecked   Boolean             @default(false) @map("is_checked")
  checkedAt   DateTime?           @map("checked_at")
  // 개인/공동 짐 — personal 은 isChecked 대신 personalChecks 가 멤버별 체크 상태의 진실.
  // shared 는 기존처럼 isChecked 공유 + assigneeUserId(담당자, 탈퇴 시 null).
  scope          ItemScope @default(personal)
  assigneeUserId BigInt?   @map("assignee_user_id")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  deletedAt   DateTime?           @map("deleted_at")

  checklist Checklist              @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  category  ChecklistCategory      @relation(fields: [categoryId], references: [id])
  template  ChecklistItemTemplate? @relation(fields: [templateId], references: [id])
  assignee  User?                  @relation("ChecklistItemAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)

  edits          ChecklistItemEdit[]
  checks         ChecklistItemCheck[]
  personalChecks ChecklistItemPersonalCheck[]
  events         UserEvent[]

  @@index([checklistId, orderIndex])
  @@index([checklistId, isSelected])
  @@index([deletedAt])
  @@map("checklist_items")
}

model ChecklistItemTemplate {
  id          BigInt      @id @default(autoincrement())
  categoryId  BigInt      @map("category_id")
  countryId   BigInt?     @map("country_id")
  title       String
  description String?
  detail      String?
  prepType    PrepType    @map("prep_type")
  baggageType BaggageType @map("baggage_type")
  conditions  Json // weather / season / companion 조건
  isEssential Boolean     @default(false) @map("is_essential")

  category ChecklistCategory @relation(fields: [categoryId], references: [id])
  country  Country?          @relation(fields: [countryId], references: [id])
  items    ChecklistItem[]
  affiliateLink AffiliateLink?

  @@index([categoryId])
  @@index([countryId])
  @@map("checklist_item_templates")
}

/// 제휴(쿠팡 파트너스 / 마이리얼트립) 링크 — 템플릿 항목 1개당 1개. 관리자 페이지에서 관리.
model AffiliateLink {
  id         BigInt   @id @default(autoincrement())
  templateId BigInt   @unique @map("template_id")
  provider   String // 'coupang' | 'mrt'
  url        String
  label      String?
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  template ChecklistItemTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@map("affiliate_links")
}

model GuideArchive {
  id              BigInt   @id @default(autoincrement())
  checklistId     BigInt   @map("checklist_id")
  name            String
  snapshot        Json // 저장 시점의 items 스냅샷
  archivedAt      DateTime @default(now()) @map("archived_at")
  isAiRecommended Boolean  @default(false) @map("is_ai_recommended")

  checklist Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([checklistId, archivedAt])
  @@map("guide_archives")
}

// =========================================================
// EDIT & CHECK LOG
// =========================================================
model ChecklistItemEdit {
  id          BigInt   @id @default(autoincrement())
  itemId      BigInt   @map("item_id")
  userId      BigInt   @map("user_id")
  editType    EditType @map("edit_type")
  beforeValue Json?    @map("before_value")
  afterValue  Json?    @map("after_value")
  occurredAt  DateTime @default(now()) @map("occurred_at")

  item ChecklistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id])

  @@index([itemId, occurredAt])
  @@index([userId, occurredAt])
  @@map("checklist_item_edits")
}

model ChecklistItemCheck {
  id         BigInt      @id @default(autoincrement())
  itemId     BigInt      @map("item_id")
  userId     BigInt      @map("user_id")
  action     CheckAction
  occurredAt DateTime    @default(now()) @map("occurred_at")

  item ChecklistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id])

  @@index([itemId, occurredAt])
  @@index([userId, occurredAt])
  @@map("checklist_item_checks")
}

// 개인 짐(scope=personal)의 멤버별 체크 상태. (itemId, userId) 당 1행 upsert.
// ChecklistItemCheck 가 "행동 로그"라면 이 테이블은 "현재 상태"다.
model ChecklistItemPersonalCheck {
  id        BigInt    @id @default(autoincrement())
  itemId    BigInt    @map("item_id")
  userId    BigInt    @map("user_id")
  isChecked Boolean   @default(false) @map("is_checked")
  checkedAt DateTime? @map("checked_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  item ChecklistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User          @relation("PersonalCheckUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([itemId, userId])
  @@index([userId])
  @@map("checklist_item_personal_checks")
}

// =========================================================
// LLM & ANALYTICS
// =========================================================
model LlmGeneration {
  id          BigInt    @id @default(autoincrement())
  tripId      BigInt    @map("trip_id")
  promptInput Json      @map("prompt_input")
  responseRaw Json?     @map("response_raw")
  model       String
  tokensUsed  Int       @default(0) @map("tokens_used")
  status      LlmStatus @default(pending)
  generatedAt DateTime  @default(now()) @map("generated_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, generatedAt])
  @@index([status])
  @@map("llm_generations")
}

model UserEvent {
  id         BigInt        @id @default(autoincrement())
  userId     BigInt?       @map("user_id")
  tripId     BigInt?       @map("trip_id")
  itemId     BigInt?       @map("item_id")
  sessionId  String        @map("session_id")
  eventType  UserEventType @map("event_type")
  metadata   Json?
  occurredAt DateTime      @default(now()) @map("occurred_at")

  user User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  trip Trip?          @relation(fields: [tripId], references: [id])
  item ChecklistItem? @relation(fields: [itemId], references: [id])

  @@index([userId, occurredAt])
  @@index([sessionId])
  @@index([eventType, occurredAt])
  @@map("user_events")
}

// context 기반 생성 결과 캐시 (tripId 없는 guest/사전 생성용)
model LlmContextCache {
  id          BigInt   @id @default(autoincrement())
  contextHash String   @unique @map("context_hash")
  context     Json
  items       Json
  summary     Json
  model       String
  hitCount    Int      @default(0) @map("hit_count")
  createdAt   DateTime @default(now()) @map("created_at")
  expiresAt   DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("llm_context_caches")
}
